{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-native",
    "paths": {
      "@components/*": ["src/components/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@store/*": ["src/store/*"],
      "@hooks/*": ["src/hooks/*"],
      "@api/*": ["src/api/*"],
      "@theme/*": ["src/shared/theme/*"]
    }
  },
  "include": ["app", "src", "*.js"],
  "exclude": ["node_modules", "ios", "android"]
}
