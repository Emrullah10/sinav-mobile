{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.0.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://odak.emrullahbozkurt.com",
        "EXPO_PUBLIC_RC_IOS_KEY": "appl_kqmuwSGXzWixjgjFKyTNHjvjSXh",
        "EXPO_PUBLIC_RC_ANDROID_KEY": "goog_VhnrrotWeGydooYgFdiqnLNxhpb"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "extends": "base",
